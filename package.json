{
  "name": "git-hush",
  "displayName": "Git Hush – Ignore & Exclude",
  "publisher": "munr0",
  "description": "Jump between .gitignore and your private .git/info/exclude, and quickly move rules across. Right-click any file to ignore it from the context menu. Supports .gitattributes too.",
  "keywords": [
    "attributes",
    "exclude",
    "git",
    "git exclude",
    "git ignore",
    "gitattributes",
    "gitignore",
    ".gitignore",
    "hide files",
    "ignore",
    "info/exclude",
    "local ignore",
    "private ignore",
    "reveal",
    "scm",
    "source control",
    "untrack",
    "untracked"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "icon": "img/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/munr0/vscode-git-hush.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onLanguage:ignore",
    "onLanguage:properties"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-hush.openExclude",
        "title": "Open Local Exclude (.git/info/exclude)",
        "category": "Git Hush"
      },
      {
        "command": "git-hush.openAttributes",
        "title": "Open Local Attributes (.git/info/attributes)",
        "category": "Git Hush"
      },
      {
        "command": "git-hush.openGitignore",
        "title": "Open .gitignore",
        "category": "Git Hush"
      },
      {
        "command": "git-hush.openGitattributes",
        "title": "Open .gitattributes",
        "category": "Git Hush"
      },
      {
        "command": "git-hush.ignoreLocally",
        "title": "Ignore Locally (.git/info/exclude)",
        "category": "Git Hush"
      },
      {
        "command": "git-hush.ignoreShared",
        "title": "Ignore for Everyone (.gitignore)",
        "category": "Git Hush"
      }
    ],
    "submenus": [
      {
        "id": "git-hush.submenu",
        "label": "Ignore"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "git-hush.submenu",
          "group": "7_modification",
          "when": "config.gitHush.showInContextMenu"
        }
      ],
      "git-hush.submenu": [
        {
          "command": "git-hush.ignoreLocally",
          "group": "ignore@1"
        },
        {
          "command": "git-hush.ignoreShared",
          "group": "ignore@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Hush",
      "properties": {
        "gitHush.showInContextMenu": {
          "type": "boolean",
          "default": true,
          "description": "Show the 'Ignore' submenu in the Explorer context menu."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
